import csv
import os

def salva_sala(sala):
    with open("sala.csv", "w", newline="") as file:
        writer = csv.writer(file)
        writer.writerows(sala)
    print("Stato della sala salvato in sala.csv")

# Funzione 1

def crea_sala():
  sala = []
  for i in range(5):
    fila = ["L"] * 10
    sala.append(fila)
  return sala


# Funzione 2

def mostra_sala(sala):
    print('\nStato sala:')
    print("       ", end="")
    for posto in range(1, 11):
        print(f"{posto:2}", end=' ')
    print()
    for i,fila in enumerate(sala, start=1):
        print(f"Fila {i}: ", end="")
        for posto in fila:
            print(f"{posto:2}", end=' ')
        print()

# Funzione 3

def prenota(sala, fila, posto):
    if fila < 1 or fila > 5 or posto < 1 or posto > 10:
        print("Coordinate non valide.")
        return False
    if sala[fila - 1][posto - 1] == "X":
        print("Posto già occupato.")
        return False
    sala[fila - 1][posto - 1] = "X"
    print(f"Prenotazione effettuata: Fila {fila}, Posto {posto}")
    return True

def carica_sala():
    if os.path.exists("sala.csv"):
        with open("sala.csv", "r") as file:
            reader = csv.reader(file)
            sala = [row for row in reader]
        print("Stato della sala caricato da sala.csv")
        return sala

